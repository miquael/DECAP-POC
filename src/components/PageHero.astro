---
interface Props {
  title: string;
  intro?: string;
  eyebrow?: string;
}

const { title, intro, eyebrow } = Astro.props;
---

<section class="page-hero">
  <div class="narrow">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="lede">{intro}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding: 76px 0 34px;
  }

  h1 {
    max-width: 780px;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 600;
    line-height: 0.96;
  }

  .lede {
    max-width: 680px;
    margin: 20px 0 0;
  }

  @media (max-width: 720px) {
    .page-hero {
      padding: 44px 0 18px;
    }
  }
</style>
