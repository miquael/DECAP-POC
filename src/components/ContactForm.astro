---
const formAction = '/thank-you/';
const formMethod = 'get';
---

<form class="contact-form" action={formAction} method={formMethod}>
  <input type="hidden" name="formType" value="contact" />
  <label>
    Name
    <input name="name" type="text" autocomplete="name" required />
  </label>
  <label>
    Email
    <input name="email" type="email" autocomplete="email" required />
  </label>
  <label>
    Inquiry Type
    <select name="inquiryType" required>
      <option value="">Select one</option>
      <option value="event">Event or speaking</option>
      <option value="media">Media inquiry</option>
      <option value="book-club">Book club</option>
      <option value="general">General note</option>
    </select>
  </label>
  <label>
    Message
    <textarea name="message" rows="6" required></textarea>
  </label>
  <button class="button" type="submit">Send Message</button>
</form>

<style>
  .contact-form {
    display: grid;
    gap: 18px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: 0 18px 50px rgba(38, 31, 26, 0.06);
  }

  label {
    display: grid;
    gap: 7px;
    color: var(--ink);
    font-size: 0.92rem;
    font-weight: 800;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 500;
  }

  input,
  select {
    min-height: 46px;
    padding: 0 12px;
  }

  textarea {
    min-height: 150px;
    padding: 12px;
    resize: vertical;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 3px solid rgba(47, 107, 98, 0.18);
    border-color: var(--accent);
  }

  .button {
    width: fit-content;
    border: 0;
    cursor: pointer;
  }
</style>
