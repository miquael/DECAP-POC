---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'home');

if (!page) {
  throw new Error('Missing home page content.');
}

const { Content } = await render(page);
const {
  title,
  eyebrow,
  headline,
  intro,
  heroImage,
  heroImageAlt,
  primaryCtaLabel,
  primaryCtaUrl,
} = page.data;
---

<BaseLayout title={`${title} | Author POC`} description={intro}>
  <section class="home-hero">
    <div class="container hero-grid">
      <div>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{headline}</h1>
        {intro && <p class="lede">{intro}</p>}
        {primaryCtaLabel && primaryCtaUrl && <a class="button" href={primaryCtaUrl}>{primaryCtaLabel}</a>}
      </div>
      {
        heroImage && (
          <div class="media-block">
            <img src={heroImage} alt={heroImageAlt ?? ''} />
          </div>
        )
      }
    </div>
  </section>
  <section class="page-section">
    <div class="narrow content">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding: 72px 0 56px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.95fr);
    gap: 48px;
    align-items: center;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 5.4rem);
    line-height: 0.96;
  }

  .lede {
    max-width: 640px;
    margin: 22px 0 28px;
  }

  @media (max-width: 820px) {
    .home-hero {
      padding: 44px 0 34px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }
</style>
