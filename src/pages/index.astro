---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'home');

if (!page) {
  throw new Error('Missing home page content.');
}

const { Content } = await render(page);
const {
  title,
  eyebrow,
  headline,
  intro,
  heroImage,
  heroImageAlt,
  primaryCtaLabel,
  primaryCtaUrl,
} = page.data;

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime())
  .slice(0, 2);
---

<BaseLayout title={`${title} | Maya Raman`} description={intro}>
  <section class="home-hero">
    {heroImage && <img class="hero-image" src={heroImage} alt={heroImageAlt ?? ''} />}
    <div class="hero-shade"></div>
    <div class="container hero-inner">
      <div class="hero-copy">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{headline}</h1>
        {intro && <p class="lede">{intro}</p>}
        <div class="hero-actions">
          {primaryCtaLabel && primaryCtaUrl && <a class="button" href={primaryCtaUrl}>{primaryCtaLabel}</a>}
          <a class="button secondary" href="/about/">Meet Maya</a>
        </div>
      </div>
    </div>
  </section>
  <section class="page-section">
    <div class="container intro-grid">
      <div class="section-kicker">
        <p class="eyebrow">Current Work</p>
        <h2>Fiction, essays, and talks for readers drawn to ritual, memory, and change.</h2>
      </div>
      <div class="content">
        <Content />
      </div>
    </div>
  </section>
  {
    recentPosts.length > 0 && (
      <section class="latest-section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Latest</p>
            <h2>Recent Notes</h2>
          </div>
          <div class="latest-grid">
            {recentPosts.map((post) => (
              <article>
                {post.data.featuredImage && <img src={post.data.featuredImage} alt={post.data.featuredImageAlt ?? ''} />}
                <p>{post.data.publishedDate.toLocaleDateString('en', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })}</p>
                <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: 560px;
    overflow: hidden;
    background: var(--ink);
  }

  .hero-image,
  .hero-shade {
    position: absolute;
    inset: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    opacity: 0.92;
  }

  .hero-shade {
    background:
      linear-gradient(90deg, rgba(25, 20, 16, 0.94), rgba(25, 20, 16, 0.78) 42%, rgba(25, 20, 16, 0.2)),
      linear-gradient(0deg, rgba(25, 20, 16, 0.28), transparent 34%);
  }

  .hero-inner {
    position: relative;
    display: flex;
    align-items: center;
    padding: 78px 0 84px;
  }

  .hero-copy {
    max-width: 760px;
    color: #fff8ec;
  }

  h1 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.8rem, 8vw, 6.3rem);
    font-weight: 600;
    line-height: 0.9;
  }

  .home-hero .eyebrow,
  .home-hero .lede {
    color: #f2d2b7;
  }

  .lede {
    max-width: 620px;
    margin: 28px 0 32px;
    color: #fff8ec;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(240px, 0.9fr) minmax(0, 1.1fr);
    gap: 54px;
    align-items: start;
  }

  .section-kicker h2,
  .section-heading h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 600;
    line-height: 1.02;
  }

  .latest-section {
    padding: 70px 0;
    background: #ffffff;
    border-top: 1px solid var(--line);
  }

  .section-heading {
    margin-bottom: 28px;
  }

  .latest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .latest-grid article {
    border-bottom: 1px solid var(--line);
    padding-bottom: 22px;
  }

  .latest-grid img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    object-position: center 28%;
    border-radius: 8px;
    margin-bottom: 18px;
  }

  .latest-grid p {
    margin: 0 0 8px;
    color: var(--warm);
    font-size: 0.88rem;
    font-weight: 800;
  }

  .latest-grid h3 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.14;
  }

  .latest-grid a {
    color: var(--ink);
    text-decoration: none;
  }

  .latest-grid a:hover {
    color: var(--accent-dark);
  }

  @media (max-width: 820px) {
    .home-hero {
      min-height: 560px;
    }

    .hero-shade {
      background: linear-gradient(0deg, rgba(25, 20, 16, 0.92), rgba(25, 20, 16, 0.34));
    }

    .hero-image {
      object-position: center 18%;
    }

    .hero-inner {
      align-items: end;
      padding: 72px 0 54px;
    }

    .intro-grid,
    .latest-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .home-hero {
      min-height: 620px;
    }

    .hero-image {
      object-position: center top;
      opacity: 0.52;
    }

    .latest-grid img {
      height: 150px;
    }
  }
</style>
