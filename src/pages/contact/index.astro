---
import { getEntry } from 'astro:content';
import ContactForm from '../../components/ContactForm.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'contact');

if (!page) {
  throw new Error('Missing contact page content.');
}

const { title, intro } = page.data;
---

<BaseLayout title={`${title} | Maya Raman`} description={intro}>
  <PageHero title={title} intro={intro} />
  <section class="page-section">
    <div class="narrow contact-form-wrap">
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-form-wrap {
    max-width: 680px;
  }
</style>
