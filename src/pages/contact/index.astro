---
import { getEntry, render } from 'astro:content';
import ContactForm from '../../components/ContactForm.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'contact');

if (!page) {
  throw new Error('Missing contact page content.');
}

const { Content } = await render(page);
const { title, intro, email } = page.data;
---

<BaseLayout title={`${title} | Maya Raman`} description={intro}>
  <PageHero title={title} intro={intro} />
  <section class="page-section">
    <div class="container contact-grid">
      <div class="content">
        {email && <p class="contact-line"><a href={`mailto:${email}`}>{email}</a></p>}
        <Content />
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(320px, 1.14fr);
    gap: 52px;
    align-items: start;
  }

  .contact-line {
    margin-bottom: 28px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.8rem, 6vw, 3.2rem);
    font-weight: 800;
    line-height: 1.05;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
