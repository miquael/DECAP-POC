---
import { getEntry, render } from 'astro:content';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const page = await getEntry('pages', 'about');

if (!page) {
  throw new Error('Missing about page content.');
}

const { Content } = await render(page);
const { title, intro, portrait, portraitAlt } = page.data;
---

<BaseLayout title={`${title} | Author POC`} description={intro}>
  <PageHero title={title} intro={intro} />
  <section class="page-section">
    <div class="container split">
      {portrait && <div class="media-block"><img src={portrait} alt={portraitAlt ?? ''} /></div>}
      <div class="content">
        <Content />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .split {
    display: grid;
    grid-template-columns: minmax(240px, 0.75fr) minmax(0, 1.25fr);
    gap: 42px;
    align-items: start;
  }

  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
